rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId)
        && incoming().keys().hasAll(['uid', 'email'])
        && incoming().uid == request.auth.uid
        && incoming().email is string && incoming().email.size() <= 256;
      allow update: if isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if isOwner(userId);
    }

    // Creator public profiles (public read for landing page visitors, owner-only write)
    match /creators/{userId} {
      allow get: if isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId)
        && incoming().userId == request.auth.uid
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().handle is string && incoming().handle.size() <= 50;
      allow update: if isOwner(userId)
        && incoming().userId == existing().userId;
      allow delete: if isOwner(userId);
    }
  }
}
